# ELC Bug Report Configuration
# Copy this file to config.yml and fill in your credentials

jira:
  base_url: https://factorialmakers.atlassian.net
  email: your-email@factorial.co
  api_token: your-jira-api-token
  project_key: FCT
  # Squad field name in Jira
  squad_field: squad[Dropdown]
  issue_types:
    - Bug
    - Chore

slack:
  bot_token: xoxb-your-slack-bot-token
  default_channel: "#employee-lifecycle-teams"

# Statuses configuration
statuses:
  active:
    - "In Code Review"
    - "In Progress"
    - "In progress"
    - "In Testing / QA"
    - "Open"
    - "Ready for Development"
    - "Ready for launch"
    - "Waiting on Product"
    - "To do"
  blocked:
    - "Blocked"
    - "Waiting on Customer"
    - "Waiting on Tech Support"

# Teams configuration
# Map team names to their squad values in Jira
teams:
  Contracts:
    - "Contracts"
  OffOnBoarding:
    - "OffOnBoarding"
  Organizations:
    - "Organizations"
