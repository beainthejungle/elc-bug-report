#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/config_loader'
require_relative '../lib/jira_client'
require_relative '../lib/slack_client'
require_relative '../lib/report_builder'

class ElcBugReport
  def initialize(args)
    @dry_run = args.include?('--dry-run')
    @channel = extract_channel(args)
    @config = ConfigLoader.load
  end

  def run
    puts "ELC Bug Report"
    puts "=" * 50
    puts "Mode: #{@dry_run ? 'DRY RUN' : 'LIVE'}"
    puts

    # Initialize Jira client
    jira = JiraClient.new(@config['jira'])

    # Get all squads from teams config
    all_squads = @config['teams'].values.flatten.uniq
    statuses = @config['statuses']

    # Fetch all issues in one call
    puts "Fetching issues from Jira..."
    issues = jira.fetch_all_issues(all_squads, statuses)

    # Fetch created vs solved last week
    puts "Fetching weekly stats..."
    weekly_stats = {
      created: jira.fetch_created_last_week_count(all_squads),
      solved: jira.fetch_solved_last_week_count(all_squads)
    }

    # Fetch SLA points
    sla_field = @config.dig('jira', 'sla_field')
    sla_points = nil
    if sla_field
      sla_points = jira.fetch_sla_points(all_squads, sla_field)
    else
      puts "No SLA field configured (jira.sla_field), skipping SLA points."
    end

    # Build the report
    report = ReportBuilder.new(
      issues, @config,
      weekly_stats: weekly_stats,
      sla_points: sla_points,
      dry_run: @dry_run
    )

    # Plain text for preview
    text = report.build_text

    puts
    puts "Report Preview:"
    puts "-" * 50
    puts text
    puts "-" * 50

    if @dry_run
      puts
      puts "Dry run complete. No message sent to Slack."
    else
      channel = @channel || @config.dig('slack', 'default_channel')
      puts
      puts "Sending to Slack channel: #{channel}"
      slack = SlackClient.new(@config['slack'])
      # Send with Block Kit blocks; text is fallback for notifications
      blocks = report.build_blocks
      slack.post_message(channel, text, blocks: blocks)
      puts "Message sent successfully!"
    end
  end

  private

  def extract_channel(args)
    channel_index = args.index('--channel')
    return nil unless channel_index

    args[channel_index + 1]
  end
end

ElcBugReport.new(ARGV).run
